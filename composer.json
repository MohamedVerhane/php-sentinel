{
  "name": "php-sentinel/php-sentinel",
  "description": "PHP Sentinel is a framework-agnostic static analysis security scanner for PHP source code. It detects common vulnerabilities without executing the scanned code.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "security",
    "static-analysis",
    "scanner",
    "audit",
    "vulnerability",
    "php-parser"
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-tokenizer": "*",
    "nikic/php-parser": "^5.0",
    "symfony/console": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "PhpSentinel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpSentinel\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/sentinel"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": false
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "analyse": [
      "@phpstan",
      "@cs-check",
      "@test"
    ]
  },
  "support": {
    "issues": "https://github.com/MohamedVerhane/php-sentinel/issues",
    "source": "https://github.com/MohamedVerhane/php-sentinel"
  }
}
